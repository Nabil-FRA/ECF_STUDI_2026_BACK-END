# ============================================
# Variables d'environnement Docker
# Copier ce fichier en .env.local pour Docker
# ============================================

# Symfony
APP_ENV=dev
APP_SECRET=docker_secret_changeme_in_production_123
APP_DEBUG=1

# PostgreSQL (Docker)
DATABASE_URL="postgresql://vg_user:vg_password@database:5432/vite_et_gourmand?serverVersion=15&charset=utf8"

# MongoDB (Docker)
MONGODB_URL="mongodb://mongodb:27017"
MONGODB_DB=vite_et_gourmand

# Mailer (Mailhog Docker)
MAILER_DSN=smtp://mailhog:1025

# Messenger
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
