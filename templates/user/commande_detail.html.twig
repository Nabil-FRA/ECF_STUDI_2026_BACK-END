{% extends 'base.html.twig' %}

{% block title %}Détail commande {{ commande.numeroCommande }} - Vite & Gourmand{% endblock %}

{% block body %}
<div style="max-width: 800px; margin: 0 auto; padding: 40px 20px;">

    <a href="{{ path('app_user_espace') }}" style="color: #007bff; text-decoration: none;">&larr; Retour à mon espace</a>

    <h1 style="margin-top: 20px;">Commande {{ commande.numeroCommande }}</h1>

    {# Messages flash #}
    {% for message in app.flashes('success') %}
        <div style="background: #d4edda; color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
            {{ message }}
        </div>
    {% endfor %}

    {# ============ STATUT ============ #}
    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
        <h3 style="margin-top: 0;">Statut actuel</h3>
        <span style="display: inline-block; padding: 8px 16px; border-radius: 20px; font-weight: bold;
            background: {% if commande.statut == 'terminée' %}#d4edda{% elseif commande.statut == 'annulée' %}#f8d7da{% elseif commande.statut == 'en cours' %}#fff3cd{% else %}#cce5ff{% endif %};
            color: {% if commande.statut == 'terminée' %}#155724{% elseif commande.statut == 'annulée' %}#721c24{% elseif commande.statut == 'en cours' %}#856404{% else %}#004085{% endif %};">
            {{ commande.statut|capitalize }}
        </span>
    </div>

    {# ============ DÉTAIL DE LA COMMANDE ============ #}
    <div style="background: #fff; border: 1px solid #ddd; padding: 25px; border-radius: 8px; margin-bottom: 20px;">
        <h3 style="margin-top: 0;">Détail</h3>

        <table style="width: 100%; border-collapse: collapse;">
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px 0; color: #666;">Menu</td>
                <td style="padding: 10px 0; font-weight: bold;">
                    {% if commande.menu %}
                        {{ commande.menu.titre }}
                    {% else %}
                        —
                    {% endif %}
                </td>
            </tr>
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px 0; color: #666;">Nombre de personnes</td>
                <td style="padding: 10px 0;">{{ commande.nombrePersonne }}</td>
            </tr>
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px 0; color: #666;">Date de la prestation</td>
                <td style="padding: 10px 0;">
                    {% if commande.datePrestation %}
                        {{ commande.datePrestation|date('d/m/Y') }}
                    {% else %}—{% endif %}
                </td>
            </tr>
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px 0; color: #666;">Lieu</td>
                <td style="padding: 10px 0;">{{ commande.lieuPrestation }}</td>
            </tr>
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px 0; color: #666;">Heure de livraison</td>
                <td style="padding: 10px 0;">{{ commande.heureLivraison }}</td>
            </tr>
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px 0; color: #666;">Prix du menu</td>
                <td style="padding: 10px 0;">{{ commande.prixMenu|number_format(2, ',', ' ') }} €</td>
            </tr>
            <tr style="border-bottom: 1px solid #eee;">
                <td style="padding: 10px 0; color: #666;">Frais de livraison</td>
                <td style="padding: 10px 0;">{{ commande.prixLivraison|number_format(2, ',', ' ') }} €</td>
            </tr>
            <tr>
                <td style="padding: 10px 0; color: #666; font-weight: bold;">Total</td>
                <td style="padding: 10px 0; font-weight: bold; font-size: 1.1em;">
                    {{ (commande.prixMenu + commande.prixLivraison)|number_format(2, ',', ' ') }} €
                </td>
            </tr>
        </table>
    </div>

    {# ============ SUIVI DE COMMANDE (MongoDB) ============ #}
    {% if suivi|length > 0 %}
        <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
            <h3 style="margin-top: 0;">Suivi de votre commande</h3>
            <div style="margin-left: 10px;">
                {% for etape in suivi %}
                    <div style="display: flex; align-items: flex-start; gap: 15px; padding-bottom: 15px; position: relative;">

                        {# Ligne verticale entre les étapes #}
                        {% if not loop.last %}
                            <div style="position: absolute; left: 8px; top: 18px; width: 2px; height: 100%; background: #007bff;"></div>
                        {% endif %}

                        {# Pastille #}
                        <div style="width: 18px; height: 18px; border-radius: 50%; flex-shrink: 0; margin-top: 2px;
                            background: {% if loop.last %}#28a745{% else %}#007bff{% endif %};"></div>

                        {# Texte #}
                        <div>
                            <p style="margin: 0; font-weight: bold;">{{ etape.statut|capitalize }}</p>
                            <p style="margin: 0; font-size: 0.85em; color: #666;">{{ etape.date }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# ============ ACTIONS ============ #}
    <div style="display: flex; gap: 15px; flex-wrap: wrap; margin-bottom: 20px;">

        {% if commande.statut == 'en cours' %}
            <a href="{{ path('app_user_commande_modifier', {id: commande.id}) }}"
               style="padding: 10px 20px; background: #007bff; color: #fff; text-decoration: none; border-radius: 6px;">
                ✏️ Modifier la commande
            </a>
            <a href="{{ path('app_user_commande_annuler', {id: commande.id}) }}"
               onclick="return confirm('Êtes-vous sûr de vouloir annuler cette commande ?')"
               style="padding: 10px 20px; background: #dc3545; color: #fff; text-decoration: none; border-radius: 6px;">
                ❌ Annuler la commande
            </a>
        {% endif %}

        {% if commande.statut == 'terminée' %}
            {% set dejaAvis = false %}
            {% for avis in commande.avis %}
                {% if avis.utilisateur == app.user %}
                    {% set dejaAvis = true %}
                {% endif %}
            {% endfor %}

            {% if not dejaAvis %}
                <a href="{{ path('app_user_avis', {id: commande.id}) }}"
                   style="padding: 10px 20px; background: #28a745; color: #fff; text-decoration: none; border-radius: 6px;">
                    ⭐ Donner mon avis
                </a>
            {% else %}
                <span style="padding: 10px 20px; background: #6c757d; color: #fff; border-radius: 6px;">
                    ✅ Avis déjà donné
                </span>
            {% endif %}
        {% endif %}

    </div>

</div>
{% endblock %}
