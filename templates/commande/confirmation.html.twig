{% extends 'base.html.twig' %}

{% block title %}Commande confirmée - Vite & Gourmand{% endblock %}

{% block body %}
<div style="max-width: 800px; margin: 0 auto; padding: 20px; text-align: center;">

    <div style="background: #d4edda; padding: 30px; border-radius: 8px; margin-bottom: 20px;">
        <h1 style="color: #155724; margin-top: 0;">Commande confirmée !</h1>
        <p style="font-size: 1.2em;">Numéro : <strong>{{ commande.numeroCommande }}</strong></p>
    </div>

    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; text-align: left; margin-bottom: 20px;">
        <h3>Récapitulatif</h3>
        <p><strong>Menu :</strong> {{ commande.menu.titre }}</p>
        <p><strong>Nombre de personnes :</strong> {{ commande.nombrePersonne }}</p>
        <p><strong>Lieu :</strong> {{ commande.lieuPrestation }}</p>
        <p><strong>Date :</strong> {{ commande.datePrestation|date('d/m/Y') }}</p>
        <p><strong>Heure :</strong> {{ commande.heureLivraison }}</p>
        <p><strong>Prêt de matériel :</strong> {{ commande.pretMateriel ? 'Oui' : 'Non' }}</p>

        <hr style="margin: 15px 0;">

        <p><strong>Prix du menu :</strong> {{ commande.prixMenu|number_format(2, ',', ' ') }} €</p>
        <p><strong>Frais de livraison :</strong> {{ commande.prixLivraison|number_format(2, ',', ' ') }} €</p>
        <p style="font-size: 1.3em; font-weight: bold;">
            Total : {{ (commande.prixMenu + commande.prixLivraison)|number_format(2, ',', ' ') }} €
        </p>
    </div>

    <p><strong>Statut :</strong> {{ commande.statut }}</p>

    <a href="{{ path('app_menus') }}"
       style="display: inline-block; padding: 10px 25px; background: #007bff; color: #fff; text-decoration: none; border-radius: 6px;">
        Retour aux menus
    </a>
</div>
{% endblock %}
