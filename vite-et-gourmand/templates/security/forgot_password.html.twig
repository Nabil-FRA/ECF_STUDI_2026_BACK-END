{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Vite & Gourmand{% endblock %}

{% block body %}
<div style="max-width: 500px; margin: 0 auto; padding: 40px 20px;">
    <h1 style="text-align: center;">Mot de passe oublié</h1>

    {% for message in app.flashes('error') %}
        <div style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
            {{ message }}
        </div>
    {% endfor %}

    {% if not submitted %}
        <p style="text-align: center; color: #666; margin-bottom: 25px;">
            Entrez votre adresse email, nous vous enverrons un lien pour réinitialiser votre mot de passe.
        </p>

        <form method="POST" action="{{ path('app_forgot_password') }}" data-turbo="false"
              style="background: #f8f9fa; padding: 30px; border-radius: 8px;">
            <div style="margin-bottom: 20px;">
                <label for="email" style="display: block; font-weight: bold; margin-bottom: 5px;">Adresse email</label>
                <input type="email" id="email" name="email" required
                       placeholder="votre@email.com"
                       style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
            </div>
            <div style="text-align: center;">
                <button type="submit"
                        style="padding: 12px 30px; background: #007bff; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 1em;">
                    Envoyer le lien
                </button>
            </div>
        </form>
    {% else %}
        <div style="text-align: center; padding: 30px; background: #d4edda; border-radius: 8px;">
            <p style="font-size: 1.1em; color: #155724;">
                Si cette adresse email est associée à un compte, vous recevrez un lien de réinitialisation.
            </p>
            <p style="color: #666; margin-top: 10px;">Vérifiez votre boîte mail (et les spams).</p>
        </div>
    {% endif %}

    <p style="text-align: center; margin-top: 20px;">
        <a href="{{ path('app_login') }}">Retour à la connexion</a>
    </p>
</div>
{% endblock %}
