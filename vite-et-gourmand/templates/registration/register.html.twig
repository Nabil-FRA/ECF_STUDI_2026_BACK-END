{% extends 'base.html.twig' %}

{% block title %}S'inscrire - Vite & Gourmand{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <h1>Créer un compte</h1>

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm) }}

        <h3>Informations personnelles</h3>
        {{ form_row(registrationForm.nom) }}
        {{ form_row(registrationForm.prenom) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.telephone) }}

        <h3>Adresse</h3>
        {{ form_row(registrationForm.adresse_postale) }}
        {{ form_row(registrationForm.ville) }}
        {{ form_row(registrationForm.pays) }}

        <h3>Sécurité</h3>
        {{ form_row(registrationForm.plainPassword, {
            help: '10 caractères minimum : 1 majuscule, 1 minuscule, 1 chiffre, 1 caractère spécial'
        }) }}

        {{ form_row(registrationForm.agreeTerms) }}

        <button type="submit" style="padding: 10px 25px; background: #007bff; color: #fff; border: none; border-radius: 6px; cursor: pointer; margin-top: 15px;">
            M'inscrire
        </button>
    {{ form_end(registrationForm) }}

    <p style="margin-top: 15px;">
        Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a>
    </p>
</div>
{% endblock %}
