{% extends 'base.html.twig' %}

{% block title %}Commande {{ commande.numeroCommande }} - Vite & Gourmand{% endblock %}

{% block body %}
<div style="max-width: 800px; margin: 0 auto; padding: 20px;">
    <a href="{{ path('app_user_espace') }}" style="color: #007bff; text-decoration: none;">&larr; Retour à mon espace</a>

    <h1 style="margin-top: 15px;">Commande {{ commande.numeroCommande }}</h1>

    {% for message in app.flashes('success') %}
        <div style="background: #d4edda; color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
            {{ message }}
        </div>
    {% endfor %}

    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
        <p><strong>Statut :</strong>
            <span style="padding: 5px 12px; border-radius: 4px; font-weight: bold;
                background: {% if commande.statut == 'en cours' %}#fff3cd{% elseif commande.statut == 'accepté' %}#cce5ff{% elseif commande.statut == 'terminée' %}#d4edda{% elseif commande.statut == 'annulée' %}#f8d7da{% else %}#e9ecef{% endif %};">
                {{ commande.statut }}
            </span>
        </p>
        <p><strong>Menu :</strong> {{ commande.menu.titre }}</p>
        <p><strong>Nombre de personnes :</strong> {{ commande.nombrePersonne }}</p>
        <p><strong>Lieu :</strong> {{ commande.lieuPrestation }}</p>
        <p><strong>Date :</strong> {{ commande.datePrestation|date('d/m/Y') }}</p>
        <p><strong>Heure :</strong> {{ commande.heureLivraison }}</p>
        <p><strong>Prêt de matériel :</strong> {{ commande.pretMateriel ? 'Oui' : 'Non' }}</p>
    </div>

    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
        <h3 style="margin-top: 0;">Détail du prix</h3>
        <p><strong>Prix du menu :</strong> {{ commande.prixMenu|number_format(2, ',', ' ') }} €</p>
        <p><strong>Frais de livraison :</strong> {{ commande.prixLivraison|number_format(2, ',', ' ') }} €</p>
        <p style="font-size: 1.3em; font-weight: bold;">
            Total : {{ (commande.prixMenu + commande.prixLivraison)|number_format(2, ',', ' ') }} €
        </p>
    </div>

    {# Actions selon le statut #}
    {% if commande.statut == 'en cours' %}
        <div style="display: flex; gap: 10px;">
            <a href="{{ path('app_user_commande_modifier', {id: commande.id}) }}"
               style="padding: 10px 20px; background: #ffc107; color: #000; text-decoration: none; border-radius: 6px;">
                Modifier
            </a>
            <a href="{{ path('app_user_commande_annuler', {id: commande.id}) }}"
               style="padding: 10px 20px; background: #dc3545; color: #fff; text-decoration: none; border-radius: 6px;"
               onclick="return confirm('Êtes-vous sûr ?');">
                Annuler
            </a>
        </div>
    {% endif %}

    {% if commande.statut == 'terminée' %}
        <a href="{{ path('app_user_avis', {id: commande.id}) }}"
           style="display: inline-block; padding: 10px 20px; background: #28a745; color: #fff; text-decoration: none; border-radius: 6px;">
            Donner un avis
        </a>
    {% endif %}

    {# Avis déjà donnés #}
    {% if commande.avis|length > 0 %}
        <div style="margin-top: 20px;">
            <h3>Votre avis</h3>
            {% for avis in commande.avis %}
                <div style="background: #f8f9fa; padding: 15px; border-radius: 8px;">
                    <p><strong>Note :</strong> {% for i in 1..avis.note %}⭐{% endfor %} ({{ avis.note }}/5)</p>
                    {% if avis.description %}
                        <p>{{ avis.description }}</p>
                    {% endif %}
                    <p style="font-size: 0.85em; color: #666;">Statut : {{ avis.statut }}</p>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
