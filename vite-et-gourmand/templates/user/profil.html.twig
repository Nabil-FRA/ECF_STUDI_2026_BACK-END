{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Vite & Gourmand{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <a href="{{ path('app_user_espace') }}" style="color: #007bff; text-decoration: none;">&larr; Retour à mon espace</a>

    <h1 style="margin-top: 15px;">Mon Profil</h1>

    {% for message in app.flashes('success') %}
        <div style="background: #d4edda; color: #155724; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
            {{ message }}
        </div>
    {% endfor %}

    {{ form_start(form) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.prenom) }}
        {{ form_row(form.email) }}
        {{ form_row(form.telephone) }}
        {{ form_row(form.adresse_postale) }}
        {{ form_row(form.ville) }}
        {{ form_row(form.pays) }}

        <button type="submit" style="padding: 10px 25px; background: #007bff; color: #fff; border: none; border-radius: 6px; cursor: pointer; margin-top: 15px;">
            Enregistrer
        </button>
    {{ form_end(form) }}
</div>
{% endblock %}
