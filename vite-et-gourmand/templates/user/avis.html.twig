{% extends 'base.html.twig' %}

{% block title %}Donner un avis - Vite & Gourmand{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <a href="{{ path('app_user_commande_detail', {id: commande.id}) }}" style="color: #007bff; text-decoration: none;">&larr; Retour à la commande</a>

    <h1 style="margin-top: 15px;">Donner un avis</h1>
    <p>Commande <strong>{{ commande.numeroCommande }}</strong> — Menu : {{ commande.menu.titre }}</p>

    {{ form_start(form) }}
        {{ form_row(form.note) }}
        {{ form_row(form.description) }}

        <button type="submit" style="padding: 10px 25px; background: #28a745; color: #fff; border: none; border-radius: 6px; cursor: pointer; margin-top: 15px;">
            Envoyer mon avis
        </button>
    {{ form_end(form) }}
</div>
{% endblock %}
