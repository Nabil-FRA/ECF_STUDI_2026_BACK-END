<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Vite & Gourmand{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🍽</text></svg>">
        <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #333; }
            a { color: #007bff; }
            .nav-container {
                background: #2c3e50;
                padding: 0 20px;
            }
            .nav-inner {
                max-width: 1200px;
                margin: 0 auto;
                display: flex;
                justify-content: space-between;
                align-items: center;
                height: 60px;
            }
            .nav-logo {
                color: #fff;
                font-size: 1.3em;
                font-weight: bold;
                text-decoration: none;
            }
            .nav-logo span { color: #e74c3c; }
            .nav-links { display: flex; gap: 20px; align-items: center; }
            .nav-links a {
                color: #ecf0f1;
                text-decoration: none;
                font-size: 0.95em;
                padding: 8px 12px;
                border-radius: 4px;
                transition: background 0.2s;
            }
            .nav-links a:hover { background: rgba(255,255,255,0.1); }
            .nav-links .btn-primary {
                background: #e74c3c;
                color: #fff;
                padding: 8px 16px;
                border-radius: 6px;
            }
            .nav-links .btn-primary:hover { background: #c0392b; }
            .nav-links .btn-outline {
                border: 1px solid #ecf0f1;
                padding: 6px 14px;
                border-radius: 6px;
            }
        </style>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {# ============ NAVIGATION ============ #}
        <nav class="nav-container">
            <div class="nav-inner">
                <a href="{{ path('app_home') }}" class="nav-logo">
                    Vite <span>&</span> Gourmand
                </a>
                <div class="nav-links">
                    <a href="{{ path('app_home') }}">Accueil</a>
                    <a href="{{ path('app_menus') }}">Nos Menus</a>
                    <a href="{{ path('app_contact') }}">Contact</a>

                    {% if app.user %}
                        <a href="{{ path('app_user_espace') }}">Mon Espace</a>
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
                            <a href="{{ path('admin') }}">Admin</a>
                        {% endif %}
                        <a href="{{ path('app_logout') }}" class="btn-outline">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn-outline">Connexion</a>
                        <a href="{{ path('app_register') }}" class="btn-primary">S'inscrire</a>
                    {% endif %}
                </div>
            </div>
        </nav>

        {# ============ CONTENU ============ #}
        {% block body %}{% endblock %}

        {# ============ FOOTER ============ #}
        {{ render(controller('App\\Controller\\HomeController::footer')) }}
    </body>
</html>
